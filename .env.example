# Copy to .env. Gitignored, and a git worktree does not inherit the main
# checkout's copy, so each working directory needs its own.

# Parent directory of the terrain datasets, served at /terrain-datasets by
# src/start-server.js. The viewer asks for
# /terrain-datasets/terra-cognita.zarr/zarr.json, so this is the directory that
# *contains* terra-cognita.zarr.
#
# Unset, the server falls back to `L:/GIS/DEFRA` — a Windows path that resolves
# to nothing here, and the viewer shows an empty terrain layer rather than an
# error, which is a slow way to find out.
TERRACOGNITA_TERRAIN_DATASETS_ROOT=/Volumes/CrucialOx9

# Root for the older non-zarr assets: /tile, /ltile, /os, /gpx.
# MAPSYNTH_GIS_ROOT=/Volumes/CrucialOx9/data/GIS/

# Directory holding the matched DEFRA FZ/LZ composite zips
# (LIDAR-FZ_DSM-1m-2022-*.zip), read by python/codec-eval. Defaults to
# $MAPSYNTH_GIS_ROOT/DEFRA/composite-zips when that is set.
# TERRACOGNITA_DEFRA_COMPOSITE_ZIPS=/Volumes/CrucialOx9/data/GIS/DEFRA/composite-zips
